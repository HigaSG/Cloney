<Window x:Class="Cloney.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cloney" Width="1000" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/cloney.ico"
        Background="#F5F5F7" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,3,0,10" />
            <Setter Property="BorderBrush" Value="#CCCCD2" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,3,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CCCCD2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2B2B30" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B6B75" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,-6,0,10" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1C1C21" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,3,0,10" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D9480F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#D9480F" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Lista de perfis -->
        <Border Background="White" BorderBrush="#E3E3E8" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,10">
                    <TextBlock Text="Cloney" FontSize="22" FontWeight="Bold" Foreground="#1C1C21" />
                    <TextBlock Text="Vários apps, vários perfis" Foreground="#6B6B75" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="14">
                    <Button x:Name="NewButton" Content="+ Novo perfil" Click="NewButton_Click" Style="{StaticResource Primary}" />
                    <Button x:Name="DeleteButton" Content="Excluir" Click="DeleteButton_Click" />
                </StackPanel>
                <ListBox x:Name="ProfileList" BorderThickness="0" Margin="8,0"
                         SelectionChanged="ProfileList_SelectionChanged"
                         MouseDoubleClick="ProfileList_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PresetName}" Foreground="#6B6B75" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,28" MaxWidth="700" HorizontalAlignment="Left" MinWidth="460">

                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72" Background="White" CornerRadius="12" BorderBrush="#E3E3E8" BorderThickness="1">
                        <Image x:Name="IconPreview" Width="56" Height="56" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="HeaderText" Text="Novo perfil" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="HeaderSub" Foreground="#6B6B75" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Aplicativo" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Nome do perfil" />
                <TextBox x:Name="NameBox" TextChanged="LookChanged" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Tipo de aplicativo" />
                <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged" />

                <Border x:Name="NoteBorder" Background="#FFF4E5" BorderBrush="#F5C27A" BorderThickness="1"
                        CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="#6A3D00" />
                </Border>

                <TextBlock Style="{StaticResource FieldLabel}" Text="Executável" />
                <DockPanel>
                    <Button x:Name="BrowseExeButton" DockPanel.Dock="Right" Content="Procurar…"
                            Style="{StaticResource BrowseButton}" Click="BrowseExe_Click" />
                    <TextBox x:Name="ExeBox" TextChanged="LookChanged" />
                </DockPanel>
                <TextBlock x:Name="ExeHint" Style="{StaticResource Hint}" />

                <TextBlock Style="{StaticResource Section}" Text="Dados" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta de dados" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource BrowseButton}" Click="OpenData_Click" />
                    <Button DockPanel.Dock="Right" Content="Procurar…" Style="{StaticResource BrowseButton}" Click="BrowseData_Click" />
                    <TextBox x:Name="DataBox" TextChanged="DataBox_TextChanged" />
                </DockPanel>
                <TextBlock x:Name="DataHint" Style="{StaticResource Hint}" />

                <CheckBox x:Name="WipeCheck" Content="Apagar os dados quando o app fechar (sessão descartável)" />

                <TextBlock Style="{StaticResource Section}" Text="Inicialização" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Argumentos extras" />
                <TextBox x:Name="ArgsBox" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Variáveis de ambiente (uma por linha: NOME=valor)" />
                <TextBox x:Name="EnvBox" AcceptsReturn="True" Height="64" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Pasta de trabalho (opcional)" />
                <TextBox x:Name="WorkDirBox" />

                <CheckBox x:Name="TrayCheck" Content="Mostrar ícone na bandeja enquanto o app estiver aberto" />
                <CheckBox x:Name="RestartCheck" Content="Reabrir o app automaticamente quando ele fechar" />

                <TextBlock Style="{StaticResource Section}" Text="Aparência" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Ícone personalizado (.ico, .png ou .exe; vazio = ícone do app)" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Procurar…" Style="{StaticResource BrowseButton}" Click="BrowseIcon_Click" />
                    <TextBox x:Name="IconBox" TextChanged="LookChanged" />
                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Etiqueta (até 3 letras)" />
                        <TextBox x:Name="BadgeBox" Width="110" HorizontalAlignment="Left" MaxLength="3" TextChanged="LookChanged" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Cor (#RRGGBB)" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ColorBox" Width="100" TextChanged="LookChanged" />
                            <WrapPanel x:Name="Swatches" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <CheckBox x:Name="DesktopCheck" Content="Criar atalho também na Área de Trabalho" />

                <Separator Margin="0,16" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Salvar" Click="Save_Click" Style="{StaticResource Primary}" />
                    <Button Content="Salvar e abrir" Click="SaveAndLaunch_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#2F7A3E" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
